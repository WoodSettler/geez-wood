---
import Base from '../layouts/Base.astro';
import { SITE } from '../site.config.js';
import { getEntry } from 'astro:content';

// 页面文案 (可在 src/content/pages/about.md 编辑; 正文随笔即该文件正文区)
const entry = await getEntry('pages', 'about');
const page = entry.data;
const { Content } = await entry.render();
---

<Base current="about" title="about">
  <main class="shell">

    <div class="crumb">
      <div>§ 06 · <b>about</b> · 关于这个人</div>
      <div class="right">last revised · 2026·05 · ~ 5 min read</div>
    </div>

    <section class="about-hero">
      <div class="wash-bg"></div>
      <h1>{page.heroGreeting} <span class="name">{SITE.name}</span><span class="dot">.</span></h1>
      <div class="lhs">
        {page.taglines.map(t => <p class="tagline" set:html={t}></p>)}
        <dl class="factsheet">
          {page.factsheet.map(row => (
            <Fragment>
              <dt>{row.dt}</dt>
              <dd set:html={row.dd.replace('{name}', SITE.name).replace('{location}', SITE.location)}></dd>
            </Fragment>
          ))}
        </dl>
      </div>

      <aside class="rhs">
        <blockquote class="hero-quote" set:html={page.heroQuote}></blockquote>
        <small class="quote-source">{page.quoteSource}</small>
      </aside>
    </section>

    <article class="essay">

      <Content />

      <ol class="beliefs">
        {page.beliefs.map(it => (
          <li><b>{it.title}</b> <Fragment set:html={it.body} /></li>
        ))}
      </ol>

      <hr/>

      <div class="signoff">
        <div class="left">
          <p>{page.signoff.left}</p>
        </div>
        <div class="signature">
          {SITE.name}
          <small>{page.signoff.sigSmall.replace('{location}', SITE.location)}</small>
        </div>
      </div>

    </article>

    <div class="onward">
      {page.onward.map(o => (
        <a href={o.href}>
          <span class="eb">{o.eb}</span>
          <span class="t">{o.t}</span>
          {o.d && <span class="d">{o.d}</span>}
        </a>
      ))}
    </div>

  </main>
</Base>

<style>
  .crumb { padding: 24px 0 8px; display: flex; justify-content: space-between; font-family: var(--font-h); font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-3); }
  .crumb b { color: var(--ink); font-weight: 500; }
  .crumb .right { font-family: var(--font-mono); font-size: 11px; color: var(--ink-4); letter-spacing: 0.06em; }

  .about-hero { padding: 56px 0 88px; position: relative; max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 1.5fr 1fr; gap: 24px 56px; align-items: start; }
  .about-hero > h1 { grid-column: 1 / -1; }
  .about-hero .rhs { align-self: center; }
  .about-hero .hero-quote { font-family: var(--font-display); font-style: italic; font-weight: 400; font-size: clamp(20px, 2.2vw, 26px); line-height: 1.35; color: var(--ink); border-left: 3px solid var(--dye-tomato); padding-left: 22px; margin: 0 0 14px; max-width: 26ch; }
  .about-hero .quote-source { display: block; font-family: var(--font-h); font-size: 11px; letter-spacing: 0.08em; color: var(--ink-3); padding-left: 22px; font-weight: 500; }
  .about-hero .wash-bg { position: absolute; right: -80px; top: 0; bottom: -40px; width: 60%; z-index: -1; filter: url(#dg-wc) blur(2px); opacity: 0.6; background: radial-gradient(50% 60% at 70% 30%, var(--sun-wash) 0%, transparent 70%), radial-gradient(60% 50% at 30% 70%, var(--sage-wash) 0%, transparent 70%); }
  .about-hero h1 { font-family: var(--font-display); font-weight: 400; font-style: normal; font-size: clamp(56px, 8vw, 116px); line-height: 0.92; letter-spacing: -0.025em; margin: 0 0 26px; text-wrap: balance; color: var(--ink); }
  .about-hero h1 .name { font-family: var(--font-sign); font-style: normal; color: var(--dye-tomato); font-size: 1.05em; letter-spacing: 0; padding: 0 4px; }
  .about-hero h1 .dot { color: var(--dye-sun); }
  .about-hero .tagline { font-family: var(--font-body); font-style: italic; font-size: 22px; line-height: 1.55; color: var(--ink-2); max-width: 44ch; margin: 0 0 36px; }
  .about-hero .tagline b { font-style: normal; font-weight: 600; color: var(--ink); }
  .about-hero .factsheet { display: grid; grid-template-columns: auto 1fr; gap: 6px 16px; font-family: var(--font-mono); font-size: 12px; color: var(--ink-2); line-height: 1.6; padding-top: 24px; border-top: 1px solid var(--ink); max-width: 50ch; }
  .about-hero .factsheet dt { color: var(--ink-3); letter-spacing: 0.06em; text-transform: uppercase; font-size: 10px; align-self: center; }
  .about-hero .factsheet dd { margin: 0; color: var(--ink); }
  .about-hero .factsheet dd b { color: var(--dye-tomato); font-weight: 500; }

  .essay { max-width: 720px; margin: 0 auto; padding: 32px 0; position: relative; }
  .essay::before { content: ""; display: block; width: 80px; height: 1px; background: var(--ink-3); margin: 0 0 32px; }
  .essay :global(p) { font-family: var(--font-body); font-size: 19px; line-height: 1.7; color: var(--ink); margin: 0 0 22px; }
  .essay :global(p em), .essay :global(p i) { font-family: var(--font-display); font-style: italic; font-size: 1.05em; }
  .essay :global(p strong) { font-weight: 600; }
  .essay :global(p code) { font-family: var(--font-mono); font-size: 0.88em; background: var(--paper-deep); padding: 0.1em 0.4em; border-radius: 2px; }
  .essay :global(p:first-of-type)::first-letter { font-family: var(--font-display); font-style: normal; font-size: 5em; line-height: 0.82; float: left; padding: 0.04em 0.12em 0 0; color: var(--dye-tomato); }
  .essay :global(h2) { font-family: var(--font-h); font-weight: 700; font-size: 22px; color: var(--ink); margin: 56px 0 18px; text-transform: lowercase; }
  .essay :global(h2)::before { content: "§ "; color: var(--dye-tomato); font-family: var(--font-display); font-style: italic; font-weight: 400; margin-right: 4px; }
  .essay blockquote { font-family: var(--font-display); font-style: normal; font-size: 32px; line-height: 1.25; color: var(--ink); border-left: 3px solid var(--dye-tomato); padding-left: 28px; margin: 40px 0; max-width: 28ch; }
  .essay hr { border: 0; width: 80px; height: 1px; background: var(--ink-3); margin: 48px auto; }
  .essay ol.beliefs { list-style: none; padding: 0; margin: 0 0 24px; counter-reset: belief; }
  .essay ol.beliefs > li { counter-increment: belief; position: relative; padding: 18px 0 18px 56px; border-bottom: 1px solid var(--rule); font-family: var(--font-body); font-size: 17px; line-height: 1.6; color: var(--ink-2); }
  .essay ol.beliefs > li:first-child { border-top: 1px solid var(--rule); }
  .essay ol.beliefs > li::before { content: counter(belief, decimal-leading-zero); position: absolute; left: 0; top: 18px; font-family: var(--font-mono); font-size: 14px; color: var(--dye-tomato); }
  .essay ol.beliefs > li b { display: block; font-family: var(--font-h); font-weight: 700; font-size: 17px; color: var(--ink); margin-bottom: 4px; }

  .signoff { margin: 56px 0 0; padding: 32px 0 0; border-top: 1px solid var(--rule); display: flex; justify-content: space-between; align-items: baseline; gap: 32px; }
  .signoff .left p { font-family: var(--font-body); font-style: italic; font-size: 15px; line-height: 1.55; color: var(--ink-3); margin: 0; max-width: 32ch; }
  .signoff .signature { font-family: var(--font-sign); font-size: 56px; line-height: 1; color: var(--dye-tomato); transform: rotate(-3deg); padding: 8px 0; }
  .signoff .signature small { display: block; font-family: var(--font-h); font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-3); transform: rotate(3deg); margin-top: 2px; font-weight: 500; }

  .onward { max-width: 1100px; margin: 80px auto 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .onward a { display: flex; flex-direction: column; gap: 6px; padding: 24px 24px 22px; border: 1px solid var(--rule); background: var(--paper); text-decoration: none; transition: transform var(--dur-base), box-shadow var(--dur-base), border-color var(--dur-base); }
  .onward a:hover { transform: translate(-2px, -2px); box-shadow: 4px 4px 0 var(--ink-3); border-color: var(--ink-3); }
  .onward a .eb { font-family: var(--font-h); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--dye-tomato); }
  .onward a .t { font-family: var(--font-display); font-style: italic; font-size: 28px; line-height: 1; color: var(--ink); margin: 4px 0 6px; }
  .onward a .d { font-family: var(--font-body); font-style: italic; font-size: 14px; line-height: 1.5; color: var(--ink-3); }

  @media (max-width: 760px) {
    .about-hero { grid-template-columns: 1fr; gap: 32px; }
    .about-hero .rhs { align-self: start; }
    .signoff { flex-direction: column; gap: 20px; align-items: flex-start; }
    .onward { grid-template-columns: 1fr; }
  }
</style>
