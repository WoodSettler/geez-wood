---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry } from 'astro:content';

// 页面文案 (可在 src/content/pages/collections.md 编辑)
const page = (await getEntry('pages', 'collections')).data;

// 集合为空时 getCollection 可能报错, 兜底成空数组
const safe = async (name) => { try { return await getCollection(name); } catch { return []; } };

const KIND_LABEL = { album: '专辑', track: '单曲', podcast: '播客' };

// 书与专辑归一成同一种卡片数据, 合并后按加入日期倒序
const books = (await safe('books')).map((b) => ({
  kind: '书',
  title: b.data.titleZh || b.data.title,
  by: [b.data.author, b.data.year].filter(Boolean).join(' · '),
  cover: null,
  tint: b.data.coverTint,
  note: b.data.note,
  link: null,
  ratio: '2 / 3',
  date: b.data.date?.valueOf() ?? 0,
}));
const albums = (await safe('listening')).map((t) => ({
  kind: KIND_LABEL[t.data.kind] ?? '专辑',
  title: t.data.title,
  by: [t.data.artist, t.data.year].filter(Boolean).join(' · '),
  cover: t.data.cover ?? null,
  tint: t.data.coverTint,
  note: t.data.why,
  link: t.data.link ?? null,
  ratio: '1 / 1',
  date: t.data.date?.valueOf() ?? 0,
}));
const shelf = [...books, ...albums].sort((a, b) => b.date - a.date);
---

<Base current="collections" title="collections">
  <main class="shell">

    <header class="head">
      <h1 set:html={page.head.title}></h1>
      {page.head.p && <p set:html={page.head.p}></p>}
    </header>

    {shelf.length === 0 ? (
      <p class="empty" set:html={page.empty}></p>
    ) : (
      <section class="shelf">
        {shelf.map((it) => {
          const inner = (
            <>
              <div class="art" style={`aspect-ratio:${it.ratio}`}>
                {it.cover
                  ? <img src={it.cover} alt={`${it.title} — ${it.by}`} loading="lazy" />
                  : <div class={`swatch swatch-${it.tint}`}></div>}
                {!it.cover && <span class="title-on-cover">{it.title}</span>}
              </div>
              <div class="body">
                <span class="tag">{it.kind}</span>
                <span class="title">{it.title}</span>
                <span class="by">{it.by}</span>
                {it.note && <p class="note">{it.note}</p>}
              </div>
            </>
          );
          return it.link
            ? <a class="item is-link" href={it.link}>{inner}</a>
            : <div class="item">{inner}</div>;
        })}
      </section>
    )}

  </main>
</Base>

<style>
  .head { padding: 56px 0 40px; max-width: 760px; }
  .head h1 { font-family: var(--font-display); font-weight: 400; font-size: clamp(56px, 8vw, 112px); line-height: 0.9; letter-spacing: -0.03em; margin: 0 0 18px; }
  .head h1 :global(em) { font-style: italic; color: var(--dye-tomato); }
  .head h1 :global(.dot) { color: var(--dye-sun); }
  .head p { font-family: var(--font-body); font-style: italic; font-size: 17px; line-height: 1.55; color: var(--ink-3); margin: 0; max-width: 46ch; }

  .empty { font-family: var(--font-body); font-style: italic; color: var(--ink-3); }

  /* 统一网格: 书 (2:3) 与专辑 (1:1) 底部对齐 */
  .shelf { display: grid; grid-template-columns: repeat(4, 1fr); gap: 48px 32px; align-items: end; }
  .item { display: flex; flex-direction: column; gap: 12px; color: inherit; text-decoration: none; }
  .art { position: relative; overflow: hidden; background: var(--paper-deep); border: 1px solid var(--ink-3); box-shadow: 0 6px 12px -6px rgba(58,51,43,0.25); transition: transform 400ms var(--ease-soft), box-shadow var(--dur-base); }
  .item.is-link:hover .art { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--ink-2); }
  .art img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .art .swatch { position: absolute; inset: 0; opacity: 0.75; filter: url(#dg-wc) blur(2px); }
  .art .title-on-cover { position: absolute; inset: 0; padding: 16px; font-family: var(--font-card); font-size: 18px; line-height: 1.15; color: var(--ink); }

  .body { display: flex; flex-direction: column; gap: 4px; }
  .tag { align-self: flex-start; font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em; padding: 2px 7px; border: 1px solid var(--ink-3); color: var(--ink-2); border-radius: 2px; margin-bottom: 4px; }
  .title { font-family: var(--font-body); font-style: italic; font-size: 16px; line-height: 1.25; color: var(--ink); }
  .item.is-link:hover .title { color: var(--dye-tomato); }
  .by { font-family: var(--font-mono); font-size: 11px; color: var(--ink-3); letter-spacing: 0.04em; }
  .note { font-family: var(--font-body); font-style: italic; font-size: 13px; line-height: 1.45; color: var(--ink-3); margin: 6px 0 0; }

  .swatch-t { background: radial-gradient(60% 60% at 30% 30%, var(--tomato-wash), transparent 70%), radial-gradient(50% 50% at 70% 70%, var(--sun-wash), transparent 70%); }
  .swatch-s { background: radial-gradient(60% 60% at 30% 30%, var(--sage-wash), transparent 70%), radial-gradient(50% 50% at 70% 70%, var(--sun-wash), transparent 70%); }
  .swatch-p { background: radial-gradient(60% 60% at 30% 30%, var(--plum-wash), transparent 70%), radial-gradient(50% 50% at 70% 70%, var(--rose-wash), transparent 70%); }
  .swatch-u { background: radial-gradient(60% 60% at 30% 30%, var(--sun-wash), transparent 70%), radial-gradient(50% 50% at 70% 70%, var(--tomato-wash), transparent 70%); }
  .swatch-n { background: var(--paper-deep); }

  @media (max-width: 1100px) { .shelf { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 760px)  { .shelf { grid-template-columns: repeat(2, 1fr); gap: 36px 20px; } }
</style>
