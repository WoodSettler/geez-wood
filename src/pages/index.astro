---
/**
 * 首页 — 极简个人名片与站点索引页。
 * 独立于内页顶栏 (<Base bare>), 沿用全站暖纸 + 孔版印刷视觉系统:
 * 名片头 (Mark + 身份 + 联系) → 01–04 站点索引 → 全站最近更新混排。
 */
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import { SITE, NAV } from '../site.config.js';
import { getCollection } from 'astro:content';

// 集合为空时 getCollection 可能抛错, 统一兜底
const safe = async (name, filter) => {
  try {
    return filter ? await getCollection(name, filter) : await getCollection(name);
  } catch {
    return [];
  }
};

const essays = (await safe('essays', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const books = await safe('books');
const listening = await safe('listening');
const shelfCount = books.length + listening.length;

const ESSAY_KIND = { essay: '文章', field: '随记', project: '项目', letter: '来信' };
const LISTEN_KIND = { album: '专辑', track: '单曲', podcast: '播客' };

const fmtDate = (d) =>
  d instanceof Date && !Number.isNaN(d.valueOf())
    ? d.toLocaleDateString('en-CA').replace(/-/g, '·')
    : '—';

// 全站最近更新混排 (essays + books + listening), 按日期倒序取最近 6 条
const recent = [
  ...essays.map((e) => ({
    date: e.data.date,
    ts: e.data.date.valueOf(),
    kind: ESSAY_KIND[e.data.type] ?? '文章',
    tone: 'tomato',
    title: e.data.title,
    sub: e.data.subtitle ?? '',
    href: `/writing/${e.slug}`,
  })),
  ...books.map((b) => ({
    date: b.data.date ?? null,
    ts: b.data.date?.valueOf() ?? 0,
    kind: '书',
    tone: 'sage',
    title: b.data.titleZh || b.data.title,
    sub: b.data.author,
    href: '/collections',
  })),
  ...listening.map((t) => ({
    date: t.data.date ?? null,
    ts: t.data.date?.valueOf() ?? 0,
    kind: LISTEN_KIND[t.data.kind] ?? '专辑',
    tone: 'plum',
    title: t.data.title,
    sub: t.data.artist,
    href: t.data.link ?? '/collections',
  })),
]
  .sort((a, b) => b.ts - a.ts)
  .slice(0, 6);

// 01–04 栏目索引, 顺序与 NAV 保持一致
const INDEX_META = {
  writing:     { note: '写完并公开的思考与记录', count: `${essays.length} 篇` },
  collections: { note: '书、专辑与声音',         count: `${shelfCount} 件` },
  now:         { note: '最近在做、在读、在听',   count: 'snapshot' },
  about:       { note: '关于这个人',             count: SITE.location },
};

const indexItems = NAV.map((item, i) => ({
  ...item,
  num: String(i + 1).padStart(2, '0'),
  note: INDEX_META[item.id]?.note ?? '',
  count: INDEX_META[item.id]?.count ?? '',
}));
---

<Base bare title={null}>
  <main class="sheet">
    <div class="wash" aria-hidden="true"></div>

    <!-- 1. 名片头 -->
    <header class="card-head">
      <div class="top-bar">
        <span class="brand-lockup">
          <Mark size={38} />
          <span class="eyebrow">{SITE.domain}</span>
        </span>
        <span class="loc">{SITE.location} · est. {SITE.foundedYear}</span>
      </div>

      <h1>
        <span class="who">{SITE.name}</span>
        <span class="sep" aria-hidden="true">/</span>
        <span class="brand">{SITE.brand}<span class="dot">.</span></span>
      </h1>

      <div class="contacts" aria-label="联系方式与订阅">
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        {SITE.github && (
          <>
            <span class="mid" aria-hidden="true">·</span>
            <a href={SITE.github} target="_blank" rel="noopener noreferrer">github</a>
          </>
        )}
        <span class="mid" aria-hidden="true">·</span>
        <a href="/rss.xml">rss</a>
      </div>
    </header>

    <!-- 2. 站点索引 (01–04) -->
    <section class="block" aria-labelledby="sec-index">
      <div class="sec-head">
        <h2 id="sec-index"><span class="sym">§</span> index</h2>
        <span class="hint">{indexItems.length} rooms</span>
      </div>

      <ol class="dir">
        {indexItems.map((it) => (
          <li>
            <a href={it.href}>
              <span class="num">{it.num}</span>
              <span class="label">{it.label}</span>
              <span class="note">{it.note}</span>
              <span class="meta">
                {it.count && <span class="cnt">{it.count}</span>}
                <span class="arr" aria-hidden="true">→</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <!-- 3. 最近更新 -->
    <section class="block" aria-labelledby="sec-recent">
      <div class="sec-head">
        <h2 id="sec-recent"><span class="sym">§</span> recent</h2>
        <a class="more" href="/writing">all writing →</a>
      </div>

      {recent.length > 0 ? (
        <ul class="feed">
          {recent.map((it) => (
            <li>
              <a href={it.href}>
                <time class="date" datetime={it.date ? it.date.toISOString().slice(0, 10) : undefined}>
                  {fmtDate(it.date)}
                </time>
                <span class={`tag t-${it.tone}`}>{it.kind}</span>
                <span class="entry">
                  <span class="title">{it.title}</span>
                  {it.sub && <span class="sub">{it.sub}</span>}
                </span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">林子里暂时很安静。</p>
      )}
    </section>

    <!-- 4. 极简版权尾注 -->
    <footer class="colophon">
      <span>© {SITE.foundedYear} {SITE.name} · CC BY-NC 4.0</span>
      <span>{SITE.signoff}</span>
    </footer>
  </main>
</Base>

<style>
  .sheet {
    position: relative;
    max-width: 720px;
    margin: 0 auto;
    padding: clamp(48px, 8vh, 88px) 32px 56px;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }

  /* 角落柔和孔版水彩晕染 */
  .wash {
    position: fixed;
    top: -120px;
    right: -120px;
    width: min(560px, 85vw);
    height: min(560px, 85vw);
    pointer-events: none;
    z-index: -1;
    opacity: 0.5;
    filter: url(#dg-wc) blur(4px);
    background:
      radial-gradient(48% 48% at 62% 38%, var(--sun-wash) 0%, transparent 72%),
      radial-gradient(44% 44% at 38% 62%, var(--sage-wash) 0%, transparent 72%),
      radial-gradient(36% 36% at 72% 64%, var(--tomato-wash) 0%, transparent 70%);
  }

  /* ─── 1. 名片头 ─────────────────────────────────────── */
  .card-head {
    padding-bottom: 32px;
    border-bottom: 1.5px solid var(--ink);
  }

  .top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 28px;
  }

  .brand-lockup {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  .eyebrow,
  .loc {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--ink-3);
  }

  .card-head h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(44px, 7.5vw, 72px);
    line-height: 0.96;
    letter-spacing: -0.025em;
    margin: 0 0 20px;
    color: var(--ink);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.22em;
  }

  .card-head h1 .who {
    font-family: var(--font-sign);
    color: var(--dye-tomato);
    font-size: 1.04em;
    letter-spacing: 0;
  }

  .card-head h1 .sep {
    color: var(--rule);
    font-size: 0.62em;
    font-weight: 300;
  }

  .card-head h1 .brand {
    font-style: italic;
  }

  .card-head h1 .dot {
    font-style: normal;
    color: var(--dye-sun);
  }

  .contacts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-3);
  }

  .contacts a {
    color: var(--ink-2);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 1px;
    transition: color var(--dur-base), border-color var(--dur-base);
  }

  .contacts a:hover {
    color: var(--dye-tomato);
    border-color: var(--dye-tomato);
  }

  .contacts .mid {
    color: var(--ink-4);
  }

  /* ─── 区块标题 ──────────────────────────────────────── */
  .block {
    margin-top: 40px;
  }

  .sec-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 14px;
  }

  .sec-head h2 {
    font-family: var(--font-h);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin: 0;
  }

  .sec-head .sym {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: 14px;
    color: var(--dye-tomato);
    margin-right: 4px;
  }

  .sec-head .hint,
  .sec-head .more {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--ink-4);
    text-decoration: none;
  }

  .sec-head .more:hover {
    color: var(--dye-tomato);
  }

  /* ─── 2. 站点索引 ───────────────────────────────────── */
  .dir {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--rule);
  }

  .dir li {
    border-bottom: 1px solid var(--rule);
  }

  .dir a {
    display: grid;
    grid-template-columns: 32px 132px 1fr auto;
    align-items: baseline;
    gap: 12px;
    padding: 15px 6px;
    text-decoration: none;
    color: inherit;
    transition: background var(--dur-base) var(--ease-soft);
  }

  .dir a:hover {
    background: var(--paper-soft);
  }

  .dir .num {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-4);
    transition: color var(--dur-base);
  }

  .dir a:hover .num {
    color: var(--dye-tomato);
  }

  .dir .label {
    font-family: var(--font-h);
    font-weight: 700;
    font-size: 17px;
    color: var(--ink);
    letter-spacing: -0.005em;
    transition: color var(--dur-base);
  }

  .dir a:hover .label {
    color: var(--dye-tomato);
  }

  .dir .note {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 15px;
    color: var(--ink-3);
  }

  .dir .meta {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-4);
    white-space: nowrap;
  }

  .dir .arr {
    display: inline-block;
    color: var(--ink-3);
    transition: transform var(--dur-base) var(--ease-out), color var(--dur-base);
  }

  .dir a:hover .arr {
    transform: translateX(4px);
    color: var(--dye-tomato);
  }

  /* ─── 3. 最近更新 ───────────────────────────────────── */
  .feed {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--rule);
  }

  .feed li {
    border-bottom: 1px dotted var(--rule);
  }

  .feed a {
    display: grid;
    grid-template-columns: 92px 46px 1fr;
    align-items: baseline;
    gap: 14px;
    padding: 13px 6px;
    text-decoration: none;
    color: inherit;
    transition: background var(--dur-base) var(--ease-soft);
  }

  .feed a:hover {
    background: var(--paper-soft);
  }

  .feed .date {
    font-family: var(--font-mono);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    color: var(--ink-4);
    white-space: nowrap;
  }

  .feed .tag {
    justify-self: start;
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.4;
    padding: 1px 6px;
    border-radius: 2px;
    border: 1px solid currentColor;
    white-space: nowrap;
  }

  .feed .t-tomato { color: var(--dye-tomato); background: var(--tomato-wash); }
  .feed .t-sage   { color: #4A6A47;           background: var(--sage-wash); }
  .feed .t-plum   { color: var(--dye-plum);   background: var(--plum-wash); }

  .feed .entry {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    min-width: 0;
  }

  .feed .title {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.45;
    color: var(--ink);
    transition: color var(--dur-base);
  }

  .feed a:hover .title {
    color: var(--dye-tomato);
  }

  .feed .sub {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 14px;
    color: var(--ink-3);
  }

  .empty {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 15px;
    color: var(--ink-3);
    margin: 12px 0 0;
  }

  /* ─── 4. 页脚尾注 ───────────────────────────────────── */
  .colophon {
    margin-top: auto;
    padding-top: 56px;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-4);
  }

  /* ─── 响应式 ────────────────────────────────────────── */
  @media (max-width: 640px) {
    .sheet {
      padding: 36px 22px 44px;
    }

    .dir a {
      grid-template-columns: 28px 1fr auto;
      row-gap: 4px;
    }

    .dir .note {
      grid-column: 2 / -1;
      font-size: 14px;
    }

    .feed a {
      grid-template-columns: auto auto 1fr;
      row-gap: 6px;
      column-gap: 10px;
    }

    .feed .entry {
      grid-column: 1 / -1;
    }

    .colophon {
      flex-direction: column;
      gap: 6px;
      padding-top: 44px;
    }
  }
</style>
