---
/**
 * 首页 — 一屏橘子林, 无文字。
 * 前排 4 棵树是入口 (writing / collections / now / about), 只靠 aria-label 与悬停提示说明去向。
 * 横屏、竖屏各一套构图, 用 CSS 按屏幕方向切换。
 */
import Base from '../layouts/Base.astro';
import { NAV } from '../site.config.js';

// 固定种子的伪随机, 保证每次构建画面一致
function rng(seed) {
  let a = seed >>> 0;
  return () => {
    a = (a + 0x6D2B79F5) >>> 0;
    let t = a;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const LEAF   = ['#87A684', '#7A9A76', '#9DB894', '#6F8F6B'];
const ORANGE = ['#E55A30', '#E8A33D', '#EE7A3A', '#E55A30'];
const TRUNK  = '#5C4636';

// 生成一棵树的几何数据: 树干、树冠圆团、橘子
function makeTree({ x, y, s, seed, fruit = 8 }) {
  const r = rng(seed);
  const cy = y - 235 * s;                       // 树冠中心
  const crown = [];
  const blobs = 8;
  for (let i = 0; i < blobs; i++) {
    const ang = (i / blobs) * Math.PI * 2 + r() * 0.6;
    const dist = (40 + r() * 45) * s;
    crown.push({
      cx: x + Math.cos(ang) * dist * 1.15,
      cy: cy + Math.sin(ang) * dist * 0.8,
      r: (62 + r() * 30) * s,
      fill: LEAF[Math.floor(r() * LEAF.length)],
    });
  }
  crown.push({ cx: x, cy, r: 80 * s, fill: LEAF[0] });

  const fruits = [];
  for (let i = 0; i < fruit; i++) {
    const ang = r() * Math.PI * 2;
    const dist = Math.sqrt(r()) * 105 * s;
    fruits.push({
      cx: x + Math.cos(ang) * dist * 1.2,
      cy: cy + 10 * s + Math.sin(ang) * dist * 0.8,
      r: (11 + r() * 5) * s,
      fill: ORANGE[Math.floor(r() * ORANGE.length)],
    });
  }

  const b = y, t = y - 175 * s, w = 13 * s;
  const trunk = `M ${x - w} ${b} Q ${x - w * 0.6} ${b - 90 * s} ${x - w * 0.45} ${t} L ${x + w * 0.45} ${t} Q ${x + w * 0.6} ${b - 90 * s} ${x + w} ${b} Z`;
  const branches = [
    `M ${x} ${b - 110 * s} Q ${x - 30 * s} ${b - 150 * s} ${x - 55 * s} ${b - 195 * s}`,
    `M ${x} ${b - 130 * s} Q ${x + 28 * s} ${b - 165 * s} ${x + 50 * s} ${b - 210 * s}`,
  ];
  return { x, y, s, crown, fruits, trunk, branches };
}

// 地上的落果
function makeFallen(list) {
  return list.map(([cx, cy, rr]) => ({ cx, cy, r: rr }));
}

// 入口树对应的页面, 顺序与 NAV 一致
const doors = NAV.map((n) => ({ href: n.href, label: n.label }));

// ── 横屏构图 1600 × 900 ─────────────────────────────────
const wide = {
  vb: '0 0 1600 900',
  sun: { cx: 1240, cy: 210, r: 110 },
  ground: 'M 0 640 Q 400 600 800 630 T 1600 615 L 1600 900 L 0 900 Z',
  ground2: 'M 0 760 Q 500 720 900 755 T 1600 740 L 1600 900 L 0 900 Z',
  back: [
    [150, 655, 0.5, 11], [470, 640, 0.46, 12], [800, 650, 0.52, 13],
    [1110, 638, 0.48, 14], [1450, 648, 0.5, 15],
  ].map(([x, y, s, seed]) => makeTree({ x, y, s, seed, fruit: 5 })),
  front: [
    [380, 815, 1.0, 21], [680, 845, 1.08, 22], [960, 825, 1.02, 23], [1250, 850, 1.1, 24],
  ].map(([x, y, s, seed]) => makeTree({ x, y, s, seed })),
  fallen: makeFallen([[450, 838, 9], [520, 852, 7], [790, 868, 8], [1060, 846, 9], [1330, 872, 7]]),
};

// ── 竖屏构图 900 × 1600 ─────────────────────────────────
const tall = {
  vb: '0 0 900 1600',
  sun: { cx: 650, cy: 330, r: 105 },
  ground: 'M 0 760 Q 250 725 450 750 T 900 735 L 900 1600 L 0 1600 Z',
  ground2: 'M 0 1180 Q 300 1140 520 1175 T 900 1160 L 900 1600 L 0 1600 Z',
  back: [
    [130, 775, 0.42, 31], [450, 765, 0.46, 32], [780, 772, 0.42, 33],
  ].map(([x, y, s, seed]) => makeTree({ x, y, s, seed, fruit: 4 })),
  front: [
    [280, 1060, 0.95, 41], [630, 1100, 0.98, 42], [300, 1450, 1.05, 43], [620, 1490, 1.08, 44],
  ].map(([x, y, s, seed]) => makeTree({ x, y, s, seed })),
  fallen: makeFallen([[370, 1080, 8], [700, 1120, 7], [400, 1472, 9], [520, 1500, 7]]),
};

const scenes = [
  { key: 'wide', ...wide, par: 'xMidYMax slice' },
  { key: 'tall', ...tall, par: 'xMidYMid slice' },
];
---

<Base bare title={null}>
  <main class="grove">
    {scenes.map((sc) => (
      <svg class={`scene ${sc.key}`} viewBox={sc.vb} preserveAspectRatio={sc.par} role="img" aria-label="Geez Wood · 橘子林">
        <defs>
          <filter id={`wc-${sc.key}`} x="-20%" y="-20%" width="140%" height="140%">
            <feTurbulence type="fractalNoise" baseFrequency="0.018" numOctaves="2" seed="5" result="n" />
            <feDisplacementMap in="SourceGraphic" in2="n" scale="16" />
          </filter>
          <filter id={`soft-${sc.key}`} x="-50%" y="-50%" width="200%" height="200%">
            <feGaussianBlur stdDeviation="18" />
          </filter>
        </defs>

        <!-- 天光与太阳 -->
        <circle cx={sc.sun.cx} cy={sc.sun.cy} r={sc.sun.r * 2.2} fill="var(--sun-wash)" filter={`url(#soft-${sc.key})`} />
        <circle class="sun" cx={sc.sun.cx} cy={sc.sun.cy} r={sc.sun.r} fill="#E8A33D" opacity="0.55" filter={`url(#wc-${sc.key})`} />

        <!-- 地面 -->
        <path d={sc.ground} fill="var(--sage-wash)" filter={`url(#wc-${sc.key})`} />
        <path d={sc.ground2} fill="var(--sage-wash)" filter={`url(#wc-${sc.key})`} />

        <!-- 远处的树, 只做背景 -->
        <g class="back" opacity="0.45" aria-hidden="true">
          {sc.back.map((t) => (
            <g>
              <path d={t.trunk} fill={TRUNK} />
              <g filter={`url(#wc-${sc.key})`}>
                {t.crown.map((c) => <circle cx={c.cx} cy={c.cy} r={c.r} fill={c.fill} opacity="0.8" />)}
              </g>
              {t.fruits.map((f) => <circle cx={f.cx} cy={f.cy} r={f.r} fill={f.fill} />)}
            </g>
          ))}
        </g>

        <!-- 前排 4 棵树 = 入口 -->
        {sc.front.map((t, i) => (
          <a class="tree" href={doors[i].href} aria-label={doors[i].label} style={`--d:${i * -1.7}s`}>
            <title>{doors[i].label}</title>
            <ellipse cx={t.x} cy={t.y + 4} rx={95 * t.s} ry={14 * t.s} fill="rgba(58,51,43,0.12)" />
            <g class="sway" style={`transform-origin:${t.x}px ${t.y}px`}>
              <path d={t.trunk} fill={TRUNK} />
              {t.branches.map((d) => <path d={d} stroke={TRUNK} stroke-width={7 * t.s} stroke-linecap="round" fill="none" />)}
              <g class="crown" filter={`url(#wc-${sc.key})`}>
                {t.crown.map((c) => <circle cx={c.cx} cy={c.cy} r={c.r} fill={c.fill} opacity="0.88" />)}
              </g>
              <g class="fruits">
                <g filter={`url(#wc-${sc.key})`}>
                  {t.fruits.map((f) => <circle cx={f.cx} cy={f.cy} r={f.r} fill={f.fill} />)}
                </g>
              </g>
            </g>
          </a>
        ))}

        <!-- 落果 -->
        <g aria-hidden="true">
          {sc.fallen.map((f) => <circle cx={f.cx} cy={f.cy} r={f.r} fill="#E55A30" opacity="0.85" />)}
        </g>
      </svg>
    ))}
  </main>
</Base>

<style>
  .grove {
    position: fixed; inset: 0;
    background:
      radial-gradient(120% 70% at 75% 15%, var(--paper-soft) 0%, transparent 60%),
      var(--paper);
    overflow: hidden;
  }
  .scene { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .scene.tall { display: none; }
  @media (orientation: portrait) {
    .scene.wide { display: none; }
    .scene.tall { display: block; }
  }

  .tree { cursor: pointer; outline: none; }
  .tree .sway {
    transform-box: view-box;
    animation: sway 7s ease-in-out infinite;
    animation-delay: var(--d);
  }
  .tree .fruits { transition: filter 400ms var(--ease-soft); }
  .tree:hover .sway, .tree:focus-visible .sway {
    animation-duration: 1.6s;
  }
  .tree:hover .fruits, .tree:focus-visible .fruits { filter: saturate(1.35) brightness(1.08); }
  .tree:focus-visible .crown { stroke: var(--dye-tomato); stroke-width: 3; }

  @keyframes sway {
    0%, 100% { transform: rotate(-0.8deg); }
    50%      { transform: rotate(0.8deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .tree .sway { animation: none; }
  }
</style>
