---
import Base from '../layouts/Base.astro';
import { SITE, FEATURES } from '../site.config.js';
import { getCollection, getEntry } from 'astro:content';

// 页面文案 (可在 src/content/pages/home.md 编辑)
const page = (await getEntry('pages', 'home')).data;

// ─── data ────────────────────────────────────────────
const allEssays = await getCollection('essays', ({ data }) => !data.draft);
const sortedEssays = allEssays.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const featured = sortedEssays.find(e => e.data.featured) ?? sortedEssays[0];

const allNotes = await getCollection('notes', ({ data }) => !data.draft);
const recentNotes = allNotes
  .sort((a, b) => b.data.lastWatered.valueOf() - a.data.lastWatered.valueOf())
  .slice(0, 3);

const fmt = (d) => d.toLocaleDateString('en-CA');   // 2026-05-22
const ago = (d) => {
  const days = Math.max(1, Math.round((Date.now() - d.getTime()) / 86400000));
  if (days < 7)  return `${days} d ago`;
  if (days < 30) return `${Math.round(days / 7)} w ago`;
  return `${Math.round(days / 30)} mo ago`;
};
---

<Base current="home" title={null}>

  <main class="shell">

    <!-- ============================================================
         HERO
         ============================================================ -->
    <section class="hero">
      <div class="wash-bg"></div>
      <svg class="home-slash" viewBox="0 0 800 600" preserveAspectRatio="none" aria-hidden="true">
        <path d="M 40 540 Q 220 470 420 360 T 780 200" pathLength="1"></path>
      </svg>

      <div class="meta-row">
        <span>since <b>{SITE.foundedYear}</b></span>
        <span>· {page.hero.season}</span>
        <span>· {SITE.location}</span>
      </div>

      <h1>
        {page.hero.line1}<br/>
        <span class="l2">{page.hero.line2}</span>
        <span class="l3">{page.hero.line3}<span class="dot">.</span></span>
      </h1>

      <p class="manifesto" set:html={page.hero.manifesto}></p>

      <div class="cta">
        {featured && (
          <a class="primary" href={`/writing/${featured.slug}`}>{page.hero.ctaPrimary}</a>
        )}
        <a class="ghost" href="/wood">{page.hero.ctaWood}</a>
        <a class="ghost" href="/now">{page.hero.ctaNow}</a>
      </div>

      <div class="scroll-hint">{page.hero.scrollHint}</div>
    </section>

    <!-- ============================================================
         FEATURED
         ============================================================ -->
    {featured && (
      <section class="featured-sec">
        <div class="sec-head">
          <div class="kicker" set:html={page.featured.kicker}></div>
          <h2 set:html={page.featured.heading}></h2>
          <a class="more" href="/writing">{page.featured.more}</a>
        </div>

        <div class="featured">
          <div class="lhs">
            <div class="eb">
              {featured.data.type} · {fmt(featured.data.date)}
              {featured.data.readingMin && ` · ${featured.data.readingMin} min`}
            </div>
            <h3>
              <a href={`/writing/${featured.slug}`}>{featured.data.title}</a>
            </h3>
            <div class="byline">
              <span>by {SITE.name}</span>
              {featured.data.tags.length > 0 && (
                <>
                  <span class="dot"></span>
                  <span>tagged {featured.data.tags.map((t, i) => (
                    <i style="color: var(--dye-tomato);">{i > 0 ? ' ' : ''}#{t}</i>
                  ))}</span>
                </>
              )}
            </div>
          </div>

          <div class="rhs">
            <p class="dropcap">{featured.data.summary}</p>
            <a class="read" href={`/writing/${featured.slug}`}>继续读 →</a>
          </div>
        </div>
      </section>
    )}

    <!-- ============================================================
         WOOD GLIMPSE
         ============================================================ -->
    <section class="wood-glimpse">
      <div class="inner">
        <div class="sec-head" style="border-bottom-color: var(--ink);">
          <div class="kicker" set:html={page.woodGlimpse.kicker}></div>
          <h2 set:html={page.woodGlimpse.heading}></h2>
          <a class="more" href="/wood">{page.woodGlimpse.more}</a>
        </div>

        {recentNotes.length === 0 ? (
          <p class="empty" set:html={page.woodGlimpse.empty}></p>
        ) : (
          <div class="notes">
            {recentNotes.map(n => (
              <a class:list={['note', n.data.stage]} href={`/wood/${n.slug}`}>
                <div class="stage">
                  <span class="blob"></span>
                  <span>{n.data.stage} · {
                    n.data.stage === 'seedling' ? '刚冒芽'
                    : n.data.stage === 'growing' ? '生长中' : '长青'
                  }</span>
                </div>
                <h4>{n.data.title}</h4>
                {n.data.summary && <p>{n.data.summary}</p>}
                <div class="foot">
                  <span>last watered · {ago(n.data.lastWatered)}</span>
                  <span class="backlinks">↗ {n.data.backlinks.length} backlinks</span>
                </div>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- ============================================================
         NOW STRIP — static for now; will render from /now content later
         ============================================================ -->
    <section class="now-sec">
      <div class="sec-head">
        <div class="kicker" set:html={page.nowSec.kicker}></div>
        <h2 set:html={page.nowSec.heading}></h2>
        <a class="more" href="/now">{page.nowSec.more}</a>
      </div>

      <div class="now-strip">
        <div class="lead">
          <div class="eb">{page.nowSec.snapshot}</div>
          <div class="t">{page.nowSec.lead}</div>
        </div>

        <div class="facets">
          <div class="facet do">
            <div class="label"><span class="g">✎</span><span>{page.nowStrip.do.label}</span></div>
            <div class="body" set:html={page.nowStrip.do.body}></div>
          </div>
          <div class="facet read">
            <div class="label"><span class="g">§</span><span>{page.nowStrip.read.label}</span></div>
            <div class="body" set:html={page.nowStrip.read.body}></div>
          </div>
          <div class="facet hear">
            <div class="label"><span class="g">♪</span><span>{page.nowStrip.hear.label}</span></div>
            <div class="body" set:html={page.nowStrip.hear.body}></div>
          </div>
          <div class="facet think">
            <div class="label"><span class="g">※</span><span>{page.nowStrip.think.label}</span></div>
            <div class="body" set:html={page.nowStrip.think.body}></div>
          </div>
        </div>

        <a class="more" href="/now">{page.nowSec.seeMore}</a>
      </div>
    </section>

    <!-- ============================================================
         LETTER SIGNUP — hidden when FEATURES.lettersForm is false
         ============================================================ -->
    {FEATURES.lettersForm && (
      <section class="letter-sec">
        <div class="letter">
          <div class="lhs">
            <div class="eb">℘ letters · monthly</div>
            <h3>letters from the wood.</h3>
            <p>
              月底一次, 一封信。 <b>本月新写的几篇 + 一段近况 + 一首在听的歌</b>。
            </p>
          </div>
          <form>
            <label for="em">你的邮箱</label>
            <div class="row">
              <input id="em" type="email" placeholder="you@elsewhere.net" required/>
              <button type="submit">订阅 →</button>
            </div>
            <div class="small">no spam · unsubscribe anytime</div>
          </form>
        </div>
      </section>
    )}

  </main>
</Base>

<!-- ============================================================
     STYLES (page-scoped)
     ============================================================ -->
<style>
  /* hero */
  .hero {
    position: relative;
    padding: 110px 0 120px;
    isolation: isolate;
  }
  .hero .wash-bg {
    position: absolute;
    inset: -40px -120px 60px;
    z-index: -2;
    filter: url(#dg-wc) blur(2px);
    opacity: 0.96;
    background:
      radial-gradient(60% 55% at 22% 30%, var(--tomato-wash) 0%, transparent 65%),
      radial-gradient(50% 50% at 78% 70%, var(--sun-wash)  0%, transparent 70%),
      radial-gradient(45% 45% at 60% 35%, var(--sage-wash) 0%, transparent 60%);
  }

  .hero .meta-row {
    display: flex; align-items: center; gap: 18px;
    font-family: var(--font-h); font-size: 12px;
    letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 28px;
  }
  .hero .meta-row::before {
    content: ""; width: 36px; height: 1px; background: var(--ink-3);
  }
  .hero .meta-row b { color: var(--dye-tomato); font-weight: 500; }

  .hero h1 {
    font-family: var(--font-display);
    font-weight: 400; font-style: normal;
    font-size: clamp(56px, 9vw, 128px);
    line-height: 0.92;
    letter-spacing: -0.025em;
    margin: 0 0 38px;
    max-width: 14ch;
    text-wrap: balance;
  }
  .hero h1 .l2  { color: var(--dye-tomato); display: block; }
  .hero h1 .l3  { color: var(--ink-2); display: block; }
  .hero h1 .dot { color: var(--dye-sun); }

  .hero .manifesto {
    font-family: var(--font-body); font-style: italic;
    font-size: 22px; line-height: 1.55;
    color: var(--ink-2);
    max-width: 48ch; margin: 0 0 44px;
  }
  .hero .manifesto b { font-style: normal; font-weight: 600; color: var(--ink); }

  .hero .cta {
    display: flex; gap: 14px; flex-wrap: wrap;
    margin-bottom: 36px;
  }
  .hero .cta a {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--font-h); font-size: 14px; font-weight: 500;
    padding: 12px 18px; border-radius: 2px;
    text-decoration: none;
    transition: transform var(--dur-base), background var(--dur-base), color var(--dur-base);
  }
  .hero .cta a.primary {
    background: var(--ink); color: var(--paper);
    border: 1.5px solid var(--ink);
  }
  .hero .cta a.primary:hover { background: var(--dye-tomato); border-color: var(--dye-tomato); transform: translate(-1px, -1px); }
  .hero .cta a.ghost {
    background: transparent; color: var(--ink-2);
    border: 1.5px solid var(--ink-3);
  }
  .hero .cta a.ghost:hover { color: var(--ink); border-color: var(--ink); transform: translate(-1px, -1px); }

  .hero .scroll-hint {
    position: absolute; left: 56px; bottom: 36px;
    font-family: var(--font-h); font-size: 11px; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--ink-3);
    display: flex; align-items: center; gap: 8px;
    animation: hint 2.4s var(--ease-soft) infinite;
  }
  .hero .scroll-hint::after { content: ""; width: 14px; height: 1px; background: var(--ink-3); }
  @keyframes hint {
    0%, 100% { transform: translateY(0); opacity: 0.6; }
    50%      { transform: translateY(4px); opacity: 1; }
  }

  .home-slash {
    position: absolute; right: -40px; top: 80px;
    width: 56%; height: 60%;
    z-index: -1; pointer-events: none;
    overflow: visible;
  }
  .home-slash path {
    fill: none;
    stroke: var(--dye-tomato);
    stroke-width: 3;
    stroke-linecap: round;
    opacity: 0.55;
    filter: url(#dg-wc-mini);
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw-slash 1800ms var(--ease-out) 300ms forwards;
  }
  @keyframes draw-slash { to { stroke-dashoffset: 0; } }

  /* section heads */
  section { padding: 88px 0; position: relative; }
  section + section { border-top: 1px solid var(--rule); }

  .sec-head {
    display: grid; grid-template-columns: auto 1fr auto;
    gap: 28px; align-items: baseline;
    margin-bottom: 44px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--ink);
  }
  .sec-head .kicker {
    font-family: var(--font-h); font-size: 12px; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--ink-3);
  }
  .sec-head .kicker b { color: var(--dye-tomato); font-weight: 500; }
  .sec-head h2 {
    font-family: var(--font-display); font-style: normal; font-weight: 400;
    font-size: clamp(38px, 4.6vw, 64px); line-height: 0.95;
    letter-spacing: -0.02em; margin: 0;
    color: var(--ink);
  }
  .sec-head h2 em { font-style: italic; }
  .sec-head .more {
    font-family: var(--font-h); font-size: 13px; font-weight: 500;
    color: var(--ink-2); text-decoration: none;
    display: inline-flex; align-items: center; gap: 6px;
  }
  .sec-head .more::after { content: "↗"; transition: transform var(--dur-base); }
  .sec-head .more:hover { color: var(--dye-tomato); }
  .sec-head .more:hover::after { transform: translate(2px, -2px); }

  /* featured */
  .featured {
    display: grid; grid-template-columns: 1.5fr 1fr;
    gap: 64px; align-items: start;
  }
  .featured .lhs .eb {
    font-family: var(--font-h); font-size: 12px; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--dye-tomato);
    margin-bottom: 16px;
  }
  .featured .lhs h3 {
    font-family: var(--font-display); font-style: italic; font-weight: 400;
    font-size: clamp(40px, 5vw, 72px); line-height: 0.95;
    letter-spacing: -0.02em; margin: 0 0 24px;
    color: var(--ink); text-wrap: balance;
  }
  .featured .lhs h3 a { text-decoration: none; }
  .featured .lhs h3 a:hover { color: var(--dye-tomato); }
  .featured .lhs .byline {
    font-family: var(--font-h); font-size: 13px; color: var(--ink-3);
    display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
  }
  .featured .lhs .byline .dot { width: 4px; height: 4px; border-radius: 50%; background: var(--ink-3); }
  .featured .rhs { border-left: 1px solid var(--ink); padding-left: 36px; }
  .featured .rhs .dropcap {
    font-family: var(--font-body); font-size: 17px; line-height: 1.65;
    color: var(--ink-2); margin: 0 0 24px;
  }
  .featured .rhs .dropcap::first-letter {
    font-family: var(--font-display); font-weight: 400;
    font-size: 4.4em; line-height: 0.82;
    float: left; padding: 0.06em 0.12em 0 0;
    color: var(--dye-tomato);
  }
  .featured .rhs .read {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--font-h); font-size: 13px; font-weight: 600;
    color: var(--ink); text-decoration: none;
    padding-bottom: 4px; border-bottom: 1.5px solid var(--dye-tomato);
  }
  .featured .rhs .read:hover { color: var(--dye-tomato); }

  /* wood glimpse */
  .wood-glimpse {
    background: var(--paper-soft);
    margin: 0 -56px; padding: 88px 56px;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .wood-glimpse .inner { max-width: 1320px; margin: 0 auto; }
  .wood-glimpse .empty {
    text-align: center; padding: 40px 0;
    font-family: var(--font-body); font-style: italic; font-size: 17px;
    color: var(--ink-3);
  }
  .wood-glimpse .empty code {
    font-family: var(--font-mono); font-size: 0.92em;
    background: var(--paper-deep); padding: 0.1em 0.4em; border-radius: 2px;
    color: var(--ink);
  }

  .notes {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px;
  }
  .note {
    background: var(--paper);
    border: 1px solid var(--rule);
    padding: 28px 26px 26px;
    position: relative;
    text-decoration: none;
    transition: transform var(--dur-base), box-shadow var(--dur-base), border-color var(--dur-base);
    display: flex; flex-direction: column; gap: 14px;
  }
  .note:hover {
    transform: translateY(-3px) rotate(-0.3deg);
    box-shadow: 0 14px 28px -14px rgba(58,51,43,0.3);
    border-color: var(--ink-3);
  }
  .note .stage {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--font-h); font-size: 11px; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--ink-3);
  }
  .note .stage .blob { width: 8px; height: 8px; border-radius: 50%; }
  .note.seedling   .stage .blob { background: var(--dye-sage); }
  .note.growing    .stage .blob { background: var(--dye-sun); }
  .note.evergreen  .stage .blob { background: var(--dye-tomato); }
  .note h4 {
    font-family: var(--font-card); font-weight: 400;
    font-size: 26px; line-height: 1.15;
    color: var(--ink); margin: 0;
    text-wrap: balance;
  }
  .note p {
    font-family: var(--font-body); font-style: italic;
    font-size: 15px; line-height: 1.55;
    color: var(--ink-3); margin: 0;
  }
  .note .foot {
    margin-top: auto; padding-top: 14px;
    border-top: 1px dashed var(--rule);
    display: flex; align-items: baseline; justify-content: space-between;
    font-family: var(--font-mono); font-size: 11px; color: var(--ink-3);
  }
  .note .foot .backlinks { color: var(--dye-tomato); }

  /* now strip */
  .now-strip {
    display: grid; grid-template-columns: auto 1fr auto;
    gap: 36px; align-items: center; padding: 32px 0;
  }
  .now-strip .lead {
    display: flex; flex-direction: column; gap: 4px;
    border-right: 1px solid var(--rule); padding-right: 36px;
  }
  .now-strip .lead .eb {
    font-family: var(--font-h); font-size: 11px; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--ink-3);
  }
  .now-strip .lead .t {
    font-family: var(--font-display); font-style: italic; font-weight: 400;
    font-size: 32px; line-height: 1; color: var(--ink);
  }
  .facets {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 0;
  }
  .facet {
    padding: 0 22px;
    border-right: 1px dashed var(--rule);
    display: flex; flex-direction: column; gap: 6px;
  }
  .facet:last-child { border-right: 0; }
  .facet .label {
    display: flex; align-items: baseline; gap: 6px;
    font-family: var(--font-h); font-weight: 600; font-size: 13px;
    color: var(--ink);
  }
  .facet .label .g {
    font-family: var(--font-display); font-style: italic; font-size: 22px;
    line-height: 0.8;
  }
  .facet .body {
    font-family: var(--font-body); font-style: italic;
    font-size: 14px; line-height: 1.4; color: var(--ink-2);
  }
  .facet.do    .label .g { color: var(--dye-tomato); }
  .facet.read  .label .g { color: var(--dye-sage); }
  .facet.hear  .label .g { color: var(--dye-sun); }
  .facet.think .label .g { color: var(--dye-plum); }

  .now-strip .more {
    font-family: var(--font-h); font-size: 13px; font-weight: 500;
    color: var(--ink-2); text-decoration: none;
    display: inline-flex; align-items: center; gap: 6px;
    white-space: nowrap;
  }
  .now-strip .more::after { content: "→"; transition: transform var(--dur-base); }
  .now-strip .more:hover { color: var(--dye-tomato); }
  .now-strip .more:hover::after { transform: translateX(4px); }

  /* responsive */
  @media (max-width: 960px) {
    .hero { padding: 70px 0 80px; }
    .hero .scroll-hint { left: 28px; }
    .featured { grid-template-columns: 1fr; gap: 32px; }
    .featured .rhs { border-left: 0; border-top: 1px solid var(--ink); padding-left: 0; padding-top: 24px; }
    .notes { grid-template-columns: 1fr; }
    .now-strip { grid-template-columns: 1fr; gap: 18px; }
    .now-strip .lead { border-right: 0; border-bottom: 1px solid var(--rule); padding-right: 0; padding-bottom: 18px; }
    .facets { grid-template-columns: repeat(2, 1fr); }
    .facet { padding: 8px 14px; border-bottom: 1px dashed var(--rule); border-right: none; }
    .wood-glimpse { margin: 0 -28px; padding: 56px 28px; }
  }
</style>
