---
import Base from '../../layouts/Base.astro';
import AudioCard from '../../components/AudioCard.astro';
import { SITE } from '../../site.config.js';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const essays = await getCollection('essays', ({ data }) => !data.draft);
  return essays.map((e) => ({ params: { slug: e.slug }, props: { entry: e } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const fmt = (d) => d.toLocaleDateString('en-CA').replace(/-/g, '·');

// next/prev essays for "continue reading"
const allEssays = (await getCollection('essays', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const idx = allEssays.findIndex((e) => e.slug === entry.slug);
const nextEssays = [allEssays[idx + 1], allEssays[idx - 1]].filter(Boolean).slice(0, 2);
---

<Base current="writing" hoverNav title={entry.data.title} description={entry.data.summary}>

  <div class="progress"><div class="bar" id="bar"></div></div>

  <main class="shell">
    <div class="article-wrap">
      <header class="article-head">
        {entry.data.featured && <div class="stamp">★ editor's pick</div>}
        <div class="eb">
          {fmt(entry.data.date)} · {entry.data.type}
          {entry.data.readingMin && ` · ${entry.data.readingMin} min`}
        </div>
        <h1>{entry.data.title}</h1>
        {entry.data.subtitle && <p class="subtitle">{entry.data.subtitle}</p>}
      </header>

      <article class="body">
        <AudioCard music={entry.data.music} cover={entry.data.cover} coverAlt={entry.data.title} />
        <Content />
      </article>

      <footer class="colophon">
        <span>by <b>{SITE.name}</b> · {SITE.location}, {entry.data.date.getFullYear()}</span>
        {entry.data.tags.length > 0 && (
          <span class="tags">{entry.data.tags.map((t) => <span>#{t}</span>)}</span>
        )}
        <a class="back" href="/writing">← 返回 writing</a>
      </footer>
    </div>

    {nextEssays.length > 0 && (
      <section class="after">
        <h3>→ <b>continue reading</b></h3>
        <div class="next-reading">
          {nextEssays.map((n) => (
            <a class="next-card" href={`/writing/${n.slug}`}>
              <span class="swatch"></span>
              <div class="card-body">
                <span class="eb">{n.data.type} · {n.data.readingMin && `${n.data.readingMin} min · `}{fmt(n.data.date)}</span>
                <span class="t">{n.data.title}</span>
                {n.data.summary && <span class="d">{n.data.summary}</span>}
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>
</Base>

<script>
  const bar = document.getElementById('bar');
  const onScroll = () => {
    const h = document.documentElement;
    const max = h.scrollHeight - h.clientHeight;
    const p = max <= 0 ? 0 : Math.max(0, Math.min(100, (h.scrollTop / max) * 100));
    if (bar) bar.style.width = p + '%';
  };
  document.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  .progress { position: fixed; top: 0; left: 0; right: 0; height: 2px; background: transparent; z-index: 80; pointer-events: none; }
  .progress .bar { height: 100%; width: 0; background: var(--dye-tomato); transition: width 100ms linear; }

  .article-wrap {
    max-width: 720px;
    margin: 0 auto;
    padding-top: clamp(44px, 6.5vh, 72px);
  }

  .article-head { margin-bottom: 28px; }
  .article-head .stamp {
    display: inline-flex; align-items: center;
    font-family: var(--font-h); font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--dye-tomato); font-weight: 600;
    padding: 3px 10px; border: 1px solid var(--dye-tomato); border-radius: 999px;
    margin-bottom: 12px;
  }
  .article-head .eb {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--ink-3); margin-bottom: 10px;
  }
  .article-head h1 {
    font-family: var(--font-display); font-weight: 400; font-style: normal;
    font-size: clamp(36px, 4.4vw, 56px); line-height: 1.08;
    letter-spacing: -0.02em; margin: 0; color: var(--ink); text-wrap: balance;
  }
  .article-head .subtitle {
    font-family: var(--font-body); font-style: italic;
    font-size: 19px; line-height: 1.5; color: var(--ink-3);
    margin: 10px 0 0;
  }

  article.body::after { content: ""; display: table; clear: both; }
  article.body :global(p) { font-family: var(--font-body); font-size: 18px; line-height: 1.78; color: var(--ink); margin: 0 0 20px; }
  article.body :global(p:first-of-type)::first-letter {
    font-family: var(--font-display); font-weight: 400; font-style: normal;
    font-size: 3.1em; line-height: 0.86; float: left;
    padding: 0.06em 0.14em 0 0; color: var(--dye-tomato);
  }
  article.body :global(p em) { font-family: var(--font-display); font-style: italic; font-size: 1.06em; color: var(--ink); }
  article.body :global(strong) { font-weight: 600; color: var(--ink); }
  article.body :global(h2) { font-family: var(--font-h); font-weight: 700; font-size: 21px; line-height: 1.25; color: var(--ink); margin: 48px 0 16px; letter-spacing: -0.005em; text-transform: lowercase; }
  article.body :global(h2)::before { content: "§ "; color: var(--dye-tomato); font-family: var(--font-display); font-style: italic; font-weight: 400; }
  article.body :global(h3) { font-family: var(--font-h); font-weight: 700; font-size: 18px; margin: 32px 0 12px; color: var(--ink); }
  article.body :global(blockquote) { font-family: var(--font-display); font-style: italic; font-weight: 400; font-size: 26px; line-height: 1.3; color: var(--ink); border-left: 3px solid var(--dye-tomato); padding: 6px 0 6px 20px; margin: 32px 0; max-width: 30ch; letter-spacing: -0.005em; text-wrap: balance; }
  article.body :global(blockquote p) { margin: 0; font-family: inherit; font-size: inherit; line-height: inherit; color: inherit; }
  article.body :global(code) { font-family: var(--font-mono); font-size: 0.86em; background: var(--paper-deep); padding: 0.1em 0.4em; border-radius: 2px; color: var(--ink); }
  article.body :global(pre) { background: var(--paper-deep); padding: 16px 18px; border-radius: 2px; overflow-x: auto; margin: 24px 0; font-size: 13px; }
  article.body :global(pre code) { background: transparent; padding: 0; font-size: 13px; }
  article.body :global(a) { color: var(--ink); text-decoration: underline; text-decoration-color: var(--dye-tomato); text-decoration-thickness: 1.5px; text-underline-offset: 0.24em; }
  article.body :global(a:hover) { color: var(--dye-tomato); }
  article.body :global(ul), article.body :global(ol) { padding-left: 1.5em; margin: 0 0 22px; }
  article.body :global(li) { font-family: var(--font-body); font-size: 17px; line-height: 1.65; color: var(--ink); margin-bottom: 6px; }
  article.body :global(hr) { border: 0; width: 80px; height: 1px; background: var(--ink-3); margin: 44px auto; }
  article.body :global(figure) { margin: 28px 0; }
  article.body :global(figure img) { max-width: 100%; height: auto; display: block; }
  article.body :global(p > img) { display: block; max-width: 100%; height: auto; margin: 26px auto; border: 1px solid var(--ink-3); box-shadow: 4px 4px 0 var(--rule); }

  /* 文末落款（原顶部 byline + tags 沉底） */
  .colophon {
    margin-top: 52px;
    padding-top: 18px;
    border-top: 1px solid var(--rule);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px 20px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-3);
  }
  .colophon b { color: var(--ink); font-weight: 500; }
  .colophon .tags { display: inline-flex; gap: 10px; flex-wrap: wrap; color: var(--dye-tomato); }
  .colophon a.back {
    color: var(--ink-2); text-decoration: none;
    border-bottom: 1px solid var(--rule);
    transition: color var(--dur-base), border-color var(--dur-base);
  }
  .colophon a.back:hover { color: var(--dye-tomato); border-color: var(--dye-tomato); }

  .after {
    max-width: 720px;
    margin: 56px auto 0;
    padding-top: 28px;
    border-top: 1px dashed var(--ink-3);
  }
  .after h3 { font-family: var(--font-h); font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--dye-tomato); margin: 0 0 16px; font-weight: 600; }
  .after h3 b { color: var(--ink); font-weight: 600; }

  .next-reading { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
  .next-card { display: grid; grid-template-columns: 44px 1fr; gap: 14px; padding: 14px; background: var(--paper); border: 1px solid var(--rule); text-decoration: none; transition: border-color var(--dur-base), transform var(--dur-base), box-shadow var(--dur-base); }
  .next-card:hover { border-color: var(--ink); transform: translate(-1px, -1px); box-shadow: 4px 4px 0 var(--ink-3); }
  .next-card .swatch { align-self: stretch; border: 1px solid var(--ink-3); background: radial-gradient(60% 60% at 40% 40%, var(--tomato-wash), transparent 70%); filter: url(#dg-wc) blur(1px); }
  .next-card .card-body { display: flex; flex-direction: column; gap: 4px; }
  .next-card .eb { font-family: var(--font-h); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-3); font-weight: 500; }
  .next-card .t { font-family: var(--font-display); font-style: italic; font-size: 20px; line-height: 1.1; color: var(--ink); }
  .next-card .d { font-family: var(--font-body); font-style: italic; font-size: 13px; color: var(--ink-3); line-height: 1.45; }

  @media (max-width: 760px) {
    .article-wrap { padding-top: 28px; }
    .next-reading { grid-template-columns: 1fr; }
  }
</style>
