---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../site.config.js';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const essays = await getCollection('essays', ({ data }) => !data.draft);
  return essays.map(e => ({ params: { slug: e.slug }, props: { entry: e } }));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();

const fmt = (d) => d.toLocaleDateString('en-CA').replace(/-/g, '·');

// pull related notes that backlink this essay's slug or share tags
const allNotes = await getCollection('notes', ({ data }) => !data.draft);
const mentions = allNotes.filter(n =>
  n.data.backlinks.includes(entry.slug) ||
  n.data.tags.some(t => entry.data.tags.includes(t))
).slice(0, 5);

// next/prev essays for "continue reading"
const allEssays = (await getCollection('essays', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const idx = allEssays.findIndex(e => e.slug === entry.slug);
const nextEssays = [allEssays[idx + 1], allEssays[idx - 1]].filter(Boolean).slice(0, 2);
---

<Base current="writing" title={entry.data.title} description={entry.data.summary}>

  <div class="progress"><div class="bar" id="bar"></div></div>

  <main class="shell">

    <div class="crumb">
      <div><a href="/writing">writing</a> <span class="sep">/</span> <b>{entry.slug}</b></div>
      <div class="right">read {entry.data.readingMin || '—'} min · scrolled <span id="pct">0</span>%</div>
    </div>

    <header class="article-head">
      {entry.data.featured && <div class="stamp">★ editor's pick · 本周一篇</div>}
      <div class="eb">{entry.data.type} · {fmt(entry.data.date)}{entry.data.readingMin && ` · ${entry.data.readingMin} min`}</div>
      <h1>{entry.data.title}</h1>
      <div class="byline">
        <span>by <b>{SITE.name}</b></span>
        <span class="dot"></span>
        <span>{SITE.location}, {entry.data.date.getFullYear()}</span>
        {entry.data.tags.length > 0 && (
          <>
            <span class="dot"></span>
            <span class="tags">tagged {entry.data.tags.map(t => <a href={`/tag/${t}`}>#{t}</a>)}</span>
          </>
        )}
      </div>
    </header>

    <article class="body">
      <Content />
    </article>

    <section class="after">
      {mentions.length > 0 && (
        <div>
          <h3>← <b>mentioned by</b> · {mentions.length} notes</h3>
          <ul class="backlinks-list">
            {mentions.map(n => (
              <li>
                <a href={`/wood/${n.slug}`}>
                  <span class:list={['stage', n.data.stage]}></span>
                  <span class="t">{n.data.title}</span>
                  <span class="meta"><b>{n.data.stage}</b> · wood</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      {nextEssays.length > 0 && (
        <div>
          <h3>→ <b>continue reading</b></h3>
          <div class="next-reading">
            {nextEssays.map(n => (
              <a class="next-card" href={`/writing/${n.slug}`}>
                <span class="swatch"></span>
                <div class="body">
                  <span class="eb">{n.data.type} · {n.data.readingMin && `${n.data.readingMin} min · `}{fmt(n.data.date)}</span>
                  <span class="t">{n.data.title}</span>
                  {n.data.summary && <span class="d">{n.data.summary}</span>}
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </section>

  </main>
</Base>

<script>
  const bar = document.getElementById('bar');
  const pct = document.getElementById('pct');
  const onScroll = () => {
    const h = document.documentElement;
    const max = h.scrollHeight - h.clientHeight;
    const p = max <= 0 ? 0 : Math.max(0, Math.min(100, (h.scrollTop / max) * 100));
    bar.style.width = p + '%';
    pct.textContent = String(Math.round(p));
  };
  document.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  .progress { position: fixed; top: 0; left: 0; right: 0; height: 2px; background: transparent; z-index: 60; pointer-events: none; }
  .progress .bar { height: 100%; width: 0; background: var(--dye-tomato); transition: width 100ms linear; }

  .crumb { padding: 24px 0 8px; display: flex; justify-content: space-between; font-family: var(--font-h); font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-3); }
  .crumb a { color: inherit; text-decoration: none; }
  .crumb a:hover { color: var(--dye-tomato); }
  .crumb .sep { color: var(--ink-4); margin: 0 6px; }
  .crumb b { color: var(--ink); font-weight: 500; }
  .crumb .right { font-family: var(--font-mono); font-size: 11px; color: var(--ink-4); letter-spacing: 0.06em; }

  .article-head { padding: 56px 0 64px; max-width: 980px; margin: 0 auto; }
  .article-head .stamp { display: inline-flex; align-items: center; gap: 12px; font-family: var(--font-h); font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--dye-tomato); font-weight: 600; padding: 5px 14px; border: 1.5px solid var(--dye-tomato); border-radius: 999px; margin-bottom: 24px; transform: rotate(-1deg); }
  .article-head .eb { font-family: var(--font-h); font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 14px; }
  .article-head h1 { font-family: var(--font-display); font-weight: 400; font-style: normal; font-size: clamp(56px, 8.4vw, 124px); line-height: 0.92; letter-spacing: -0.025em; margin: 0 0 28px; color: var(--ink); text-wrap: balance; max-width: 18ch; }
  .article-head .byline { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; font-family: var(--font-h); font-size: 13px; color: var(--ink-3); padding-top: 18px; border-top: 1px solid var(--ink); }
  .article-head .byline .dot { width: 4px; height: 4px; border-radius: 50%; background: var(--ink-3); }
  .article-head .byline b { color: var(--ink); font-weight: 600; }
  .article-head .byline .tags a { color: var(--dye-tomato); text-decoration: none; margin-left: 6px; }

  article.body { max-width: 720px; margin: 0 auto; padding: 16px 0 64px; }
  article.body :global(p) { font-family: var(--font-body); font-size: 19px; line-height: 1.72; color: var(--ink); margin: 0 0 22px; }
  article.body :global(p:first-of-type)::first-letter { font-family: var(--font-display); font-weight: 400; font-style: normal; font-size: 5.4em; line-height: 0.82; float: left; padding: 0.04em 0.12em 0 0; color: var(--dye-tomato); }
  article.body :global(p em) { font-family: var(--font-display); font-style: italic; font-size: 1.06em; color: var(--ink); }
  article.body :global(strong) { font-weight: 600; color: var(--ink); }
  article.body :global(h2) { font-family: var(--font-h); font-weight: 700; font-size: 24px; line-height: 1.2; color: var(--ink); margin: 56px 0 18px; letter-spacing: -0.005em; text-transform: lowercase; }
  article.body :global(h2)::before { content: "§ "; color: var(--dye-tomato); font-family: var(--font-display); font-style: italic; font-weight: 400; }
  article.body :global(h3) { font-family: var(--font-h); font-weight: 700; font-size: 19px; margin: 36px 0 14px; color: var(--ink); }
  article.body :global(blockquote) { font-family: var(--font-display); font-style: italic; font-weight: 400; font-size: 32px; line-height: 1.22; color: var(--ink); border-left: 3px solid var(--dye-tomato); padding: 8px 0 8px 24px; margin: 36px 0; max-width: 28ch; letter-spacing: -0.005em; text-wrap: balance; }
  article.body :global(blockquote p) { margin: 0; font-family: inherit; font-size: inherit; line-height: inherit; color: inherit; }
  article.body :global(code) { font-family: var(--font-mono); font-size: 0.86em; background: var(--paper-deep); padding: 0.1em 0.4em; border-radius: 2px; color: var(--ink); }
  article.body :global(pre) { background: var(--paper-deep); padding: 16px 18px; border-radius: 2px; overflow-x: auto; margin: 24px 0; font-size: 13px; }
  article.body :global(pre code) { background: transparent; padding: 0; font-size: 13px; }
  article.body :global(a) { color: var(--ink); text-decoration: underline; text-decoration-color: var(--dye-tomato); text-decoration-thickness: 1.5px; text-underline-offset: 0.24em; }
  article.body :global(a:hover) { color: var(--dye-tomato); }
  article.body :global(ul), article.body :global(ol) { padding-left: 1.6em; margin: 0 0 22px; }
  article.body :global(li) { font-family: var(--font-body); font-size: 18px; line-height: 1.6; color: var(--ink); margin-bottom: 8px; }
  article.body :global(hr) { border: 0; width: 80px; height: 1px; background: var(--ink-3); margin: 48px auto; }
  /* 封面图 — 画框风格, 默认居中; 不触发首字下沉 (figure 非 p) */
  article.body :global(figure.album-cover) { margin: 8px auto 36px; max-width: 340px; }
  article.body :global(figure.album-cover img) { display: block; width: 100%; height: auto; border: 1.5px solid var(--ink); box-shadow: 6px 6px 0 var(--ink-2); }
  article.body :global(figure) { margin: 32px 0; }
  article.body :global(figure img), article.body :global(p > img) { max-width: 100%; height: auto; }

  .after { max-width: 980px; margin: 80px auto 0; display: grid; grid-template-columns: 1fr 1fr; gap: 56px; padding-top: 36px; border-top: 1px dashed var(--ink-3); }
  .after h3 { font-family: var(--font-h); font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--dye-tomato); margin: 0 0 16px; font-weight: 600; }
  .after h3 b { color: var(--ink); font-weight: 600; }
  .backlinks-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .backlinks-list a { display: grid; grid-template-columns: auto 1fr; gap: 12px; align-items: baseline; padding: 14px 16px; background: var(--paper-soft); border: 1px solid var(--rule); text-decoration: none; transition: border-color var(--dur-base), transform var(--dur-base); }
  .backlinks-list a:hover { border-color: var(--ink); transform: translate(-1px, -1px); }
  .backlinks-list .stage { width: 8px; height: 8px; border-radius: 50%; align-self: center; }
  .backlinks-list .stage.seedling { background: var(--dye-sage); }
  .backlinks-list .stage.growing { background: var(--dye-sun); }
  .backlinks-list .stage.evergreen { background: var(--dye-tomato); }
  .backlinks-list .t { font-family: var(--font-body); font-style: italic; font-size: 15px; color: var(--ink); line-height: 1.3; }
  .backlinks-list .meta { grid-column: 2; font-family: var(--font-mono); font-size: 10px; color: var(--ink-3); letter-spacing: 0.04em; margin-top: 2px; }
  .backlinks-list .meta b { color: var(--dye-tomato); font-weight: 500; }

  .next-reading { display: flex; flex-direction: column; gap: 14px; }
  .next-card { display: grid; grid-template-columns: 56px 1fr; gap: 14px; padding: 16px; background: var(--paper); border: 1px solid var(--rule); text-decoration: none; transition: border-color var(--dur-base), transform var(--dur-base), box-shadow var(--dur-base); }
  .next-card:hover { border-color: var(--ink); transform: translate(-1px, -1px); box-shadow: 4px 4px 0 var(--ink-3); }
  .next-card .swatch { align-self: stretch; border: 1px solid var(--ink-3); background: radial-gradient(60% 60% at 40% 40%, var(--tomato-wash), transparent 70%); filter: url(#dg-wc) blur(1px); }
  .next-card .body { display: flex; flex-direction: column; gap: 4px; }
  .next-card .eb { font-family: var(--font-h); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-3); font-weight: 500; }
  .next-card .t { font-family: var(--font-display); font-style: italic; font-size: 22px; line-height: 1; color: var(--ink); }
  .next-card .d { font-family: var(--font-body); font-style: italic; font-size: 13px; color: var(--ink-3); line-height: 1.45; }

  @media (max-width: 760px) {
    .after { grid-template-columns: 1fr; gap: 32px; }
  }
</style>
