---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../site.config.js';
import { getCollection } from 'astro:content';

// ─── data ────────────────────────────────────────────
const essays = (await getCollection('essays', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// 按类型计数 (只显示非零)
const typeLabel = { essay: 'essays', field: 'field notes', project: 'project logs', letter: 'letters' };
const counts = essays.reduce((m, e) => { m[e.data.type] = (m[e.data.type] || 0) + 1; return m; }, {});

// 头条: 优先 featured, 否则最新一篇
const featured = essays.find(e => e.data.featured) ?? essays[0];
const rest = essays.filter(e => e !== featured);

// 卡片装饰
const fmt = (d) => d.toLocaleDateString('en-CA').replace(/-/g, '·');
const tints = ['t', 's', 'u', 'p'];
const glyphs = { essay: '¶', field: '¬', project: '◇', letter: '℘' };
const stamps = { essay: '¶ essay', field: '▾ field note', project: '◇ project log', letter: '℘ letter' };
---

<Base current="writing" title="writing" description="已经写完、愿意公开的长内容。">
  <main class="shell">

    <div class="crumb">
      <div>§ 02 · <b>writing</b> · 文章 &amp; field notes</div>
      <div class="right">{essays.length} pieces · since {SITE.foundedYear}</div>
    </div>

    <header class="writing-head">
      <h1>writing<span class="dot">.</span></h1>
      <div class="rhs">
        <div class="eb">essays · field notes · letters</div>
        <p>
          已经写完、愿意公开的长内容。 每篇至少改过几遍 — 没改完的, 还在 <a href="/wood">wood</a> 里浇水。
        </p>
        <div class="stats">
          {Object.entries(counts).map(([t, n]) => (
            <div><b>{n}</b><span>{typeLabel[t] || t}</span></div>
          ))}
        </div>
      </div>
    </header>

    {featured && (
      <section class="featured">
        <div class="cover">
          {featured.data.cover
            ? <img src={featured.data.cover} alt={featured.data.title} width="600" height="600" loading="lazy" />
            : <div class={`swatch s-${tints[0]}`}></div>}
          <span class="glyph">{glyphs[featured.data.type] || '§'}</span>
        </div>
        <div class="body">
          {featured.data.featured && <div class="stamp">★ editor's pick · 本周一篇</div>}
          <div class="eb">{featured.data.type} · {fmt(featured.data.date)}{featured.data.readingMin && ` · ${featured.data.readingMin} min`}</div>
          <h2><a href={`/writing/${featured.slug}`}>{featured.data.title}</a></h2>
          <div class="byline">
            <span>by {SITE.name}</span>
            <span class="dot"></span>
            <span>{SITE.location}, {featured.data.date.getFullYear()}</span>
          </div>
          {featured.data.summary && <p class="lead">{featured.data.summary}</p>}
          <div class="actions">
            <a class="read" href={`/writing/${featured.slug}`}>继续读 →</a>
            {featured.data.tags.length > 0 && (
              <span class="tags">{featured.data.tags.map(t => <a href={`/tag/${t}`}>#{t}</a>)}</span>
            )}
          </div>
        </div>
      </section>
    )}

    {rest.length > 0 && (
      <section class="grid">
        {rest.map((e, i) => (
          <a class="card" href={`/writing/${e.slug}`}>
            <div class="image">
              {e.data.cover
                ? <img src={e.data.cover} alt={e.data.title} width="600" height="600" loading="lazy" />
                : <div class={`swatch s-${tints[i % tints.length]}`}></div>}
              <span class="type-stamp">{stamps[e.data.type] || '¶ essay'}</span>
              <span class="glyph">{glyphs[e.data.type] || '§'}</span>
            </div>
            <div class="eb">
              <span>{fmt(e.data.date)}</span>
              {e.data.readingMin && <><span class="sep">·</span><span>{e.data.readingMin} min</span></>}
            </div>
            <h3>{e.data.title}</h3>
            {e.data.summary && <p class="blurb">{e.data.summary}</p>}
            {e.data.tags.length > 0 && (
              <div class="tagline">{e.data.tags.map(t => <span>#{t}</span>)}</div>
            )}
          </a>
        ))}
      </section>
    )}

    {essays.length === 0 && (
      <p class="empty">还没有文章 — 写一篇放进 <code>src/content/essays/</code>。</p>
    )}

  </main>
</Base>

<style>
  .crumb { padding: 24px 0 8px; display: flex; justify-content: space-between; font-family: var(--font-h); font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-3); }
  .crumb b { color: var(--ink); font-weight: 500; }
  .crumb .right { font-family: var(--font-mono); font-size: 11px; color: var(--ink-4); letter-spacing: 0.06em; }

  .writing-head { display: grid; grid-template-columns: 1.4fr 1fr; gap: 56px; align-items: end; padding: 36px 0 44px; border-bottom: 1px solid var(--ink); }
  .writing-head h1 { font-family: var(--font-display); font-weight: 400; font-size: clamp(64px, 10vw, 140px); line-height: 0.86; letter-spacing: -0.03em; margin: 0; }
  .writing-head h1 .dot { color: var(--dye-tomato); }
  .writing-head .rhs { border-left: 1px solid var(--ink); padding-left: 28px; padding-bottom: 14px; }
  .writing-head .rhs .eb { font-family: var(--font-h); font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 10px; }
  .writing-head .rhs p { font-family: var(--font-body); font-style: italic; font-size: 17px; line-height: 1.55; color: var(--ink-2); margin: 0 0 18px; max-width: 40ch; }
  .writing-head .rhs p a { color: var(--ink); text-decoration-color: var(--dye-sage); }
  .writing-head .stats { display: flex; gap: 28px; }
  .writing-head .stats div { display: flex; flex-direction: column; }
  .writing-head .stats b { font-family: var(--font-display); font-style: italic; font-size: 30px; line-height: 1; color: var(--dye-tomato); }
  .writing-head .stats span { font-family: var(--font-h); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-3); margin-top: 4px; }

  /* shared swatch palette */
  .swatch-fill, .swatch.s-t, .swatch.s-s, .swatch.s-u, .swatch.s-p { position: absolute; inset: 0; opacity: 0.78; filter: url(#dg-wc) blur(2px); }
  .s-t { background: radial-gradient(60% 60% at 30% 30%, var(--tomato-wash), transparent 70%), radial-gradient(50% 50% at 70% 70%, var(--sun-wash), transparent 70%); }
  .s-s { background: radial-gradient(60% 60% at 30% 30%, var(--sage-wash), transparent 70%), radial-gradient(50% 50% at 70% 70%, var(--sun-wash), transparent 70%); }
  .s-u { background: radial-gradient(60% 60% at 30% 30%, var(--sun-wash), transparent 70%), radial-gradient(50% 50% at 70% 70%, var(--tomato-wash), transparent 70%); }
  .s-p { background: radial-gradient(60% 60% at 30% 30%, var(--plum-wash), transparent 70%), radial-gradient(50% 50% at 70% 70%, var(--rose-wash), transparent 70%); }

  /* featured */
  .featured { display: grid; grid-template-columns: 320px 1fr; gap: 48px; align-items: center; margin: 44px 0 64px; background: var(--paper-soft); border: 1.5px solid var(--ink); box-shadow: 8px 8px 0 var(--ink-2); padding: 40px 44px; }
  .featured .cover { aspect-ratio: 1/1; border: 1.5px solid var(--ink); box-shadow: 5px 5px 0 var(--ink-2); position: relative; overflow: hidden; background: var(--paper-deep); transform: rotate(-2deg); transition: transform 400ms var(--ease-soft); }
  .featured:hover .cover { transform: rotate(0deg); }
  .featured .cover img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .featured .cover .glyph { position: absolute; right: 12px; bottom: 8px; font-family: var(--font-display); font-style: italic; font-size: 40px; color: var(--ink); opacity: 0.5; z-index: 1; }
  .featured .body .stamp { display: inline-flex; align-items: center; font-family: var(--font-h); font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--dye-tomato); font-weight: 600; padding: 5px 14px; border: 1.5px solid var(--dye-tomato); border-radius: 999px; margin-bottom: 18px; transform: rotate(-1deg); }
  .featured .body .eb { font-family: var(--font-h); font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--dye-tomato); margin-bottom: 12px; }
  .featured .body h2 { font-family: var(--font-display); font-style: italic; font-weight: 400; font-size: clamp(36px, 4.6vw, 60px); line-height: 0.98; margin: 0 0 14px; text-wrap: balance; }
  .featured .body h2 a { color: var(--ink); text-decoration: none; }
  .featured .body h2 a:hover { color: var(--dye-tomato); }
  .featured .body .byline { display: flex; align-items: center; gap: 12px; font-family: var(--font-h); font-size: 13px; color: var(--ink-3); margin-bottom: 16px; }
  .featured .body .byline .dot { width: 4px; height: 4px; border-radius: 50%; background: var(--ink-3); }
  .featured .body .lead { font-family: var(--font-body); font-size: 17px; line-height: 1.65; color: var(--ink-2); margin: 0 0 22px; max-width: 56ch; }
  .featured .body .actions { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .featured .body .read { font-family: var(--font-h); font-size: 13px; font-weight: 600; color: var(--ink); text-decoration: none; padding-bottom: 4px; border-bottom: 1.5px solid var(--dye-tomato); }
  .featured .body .read:hover { color: var(--dye-tomato); }
  .featured .body .tags a { font-family: var(--font-mono); font-size: 11px; color: var(--dye-tomato); text-decoration: none; margin-right: 8px; }

  /* grid */
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px 32px; margin-bottom: 80px; }
  .card { display: flex; flex-direction: column; text-decoration: none; transition: transform var(--dur-base); }
  .card:hover { transform: translateY(-3px); }
  .card .image { aspect-ratio: 16/10; border: 1px solid var(--ink-3); background: var(--paper-deep); position: relative; overflow: hidden; margin-bottom: 14px; transition: border-color var(--dur-base), box-shadow var(--dur-base); }
  .card:hover .image { border-color: var(--ink); box-shadow: 5px 5px 0 var(--ink-2); }
  .card .image img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .card .image .type-stamp { position: absolute; top: 10px; left: 10px; font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase; padding: 3px 7px; background: var(--paper); border: 1px solid var(--ink-3); color: var(--ink); z-index: 2; }
  .card .image .glyph { position: absolute; right: 12px; bottom: 6px; font-family: var(--font-display); font-style: italic; font-size: 34px; color: var(--ink); opacity: 0.45; z-index: 1; }
  .card .eb { font-family: var(--font-h); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); display: flex; gap: 8px; margin-bottom: 8px; }
  .card .eb .sep { color: var(--ink-4); }
  .card h3 { font-family: var(--font-card); font-weight: 400; font-size: 24px; line-height: 1.12; color: var(--ink); margin: 0 0 10px; text-wrap: balance; }
  .card .blurb { font-family: var(--font-body); font-style: italic; font-size: 15px; line-height: 1.5; color: var(--ink-3); margin: 0 0 12px; }
  .card .tagline { font-family: var(--font-mono); font-size: 11px; color: var(--dye-tomato); display: flex; gap: 10px; flex-wrap: wrap; margin-top: auto; }

  .empty { font-family: var(--font-body); font-style: italic; font-size: 17px; color: var(--ink-3); padding: 48px 0; text-align: center; }
  .empty code { font-family: var(--font-mono); background: var(--paper-deep); padding: 0.1em 0.4em; border-radius: 2px; color: var(--ink); font-style: normal; }

  @media (max-width: 1000px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 760px) {
    .writing-head { grid-template-columns: 1fr; gap: 22px; }
    .writing-head .rhs { border-left: 0; padding-left: 0; padding-top: 18px; border-top: 1px solid var(--ink); }
    .featured { grid-template-columns: 1fr; padding: 28px; gap: 24px; }
    .featured .cover { max-width: 200px; }
    .grid { grid-template-columns: 1fr; }
  }
</style>
