---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../site.config.js';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map(n => ({ params: { slug: n.slug }, props: { entry: n } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const fmt = (d) => d.toLocaleDateString('en-CA').replace(/-/g, '·');

// Resolve incoming + outgoing notes
const allNotes = await getCollection('notes', ({ data }) => !data.draft);
const incoming = allNotes.filter(n => n.data.backlinks.includes(entry.slug));
const outgoing = entry.data.backlinks
  .map(slug => allNotes.find(n => n.slug === slug))
  .filter(Boolean);

const stageZh = { seedling: '刚冒芽', growing: '生长中', evergreen: '长青' };
const stageColor = { seedling: 'sage', growing: 'sun', evergreen: 'tomato' };
---

<Base current="wood" title={entry.data.title} description={entry.data.summary}>
  <main class="shell">

    <div class="crumb">
      <div><a href="/wood">wood</a> <span class="sep">/</span> <b>{entry.slug}</b></div>
      <div class="right">last watered · {fmt(entry.data.lastWatered)}</div>
    </div>

    <header class="note-head">
      <div class={`stage-line ${entry.data.stage}`}>
        <span class="blob"></span>
        <span>{entry.data.stage} · {stageZh[entry.data.stage]}</span>
      </div>
      <h1>{entry.data.title}</h1>
      {entry.data.summary && <p class="summary">{entry.data.summary}</p>}

      <dl class="factrow">
        <dt>created</dt><dd>{fmt(entry.data.created)}</dd>
        <dt>watered</dt><dd>{fmt(entry.data.lastWatered)}</dd>
        <dt>tags</dt><dd>{entry.data.tags.map((t, i) => <a href={`/tag/${t}`}>{i > 0 ? ' ' : ''}#{t}</a>)}</dd>
        <dt>backlinks</dt><dd>{incoming.length} in · {outgoing.length} out</dd>
      </dl>
    </header>

    <article class="note-body">
      <Content />
    </article>

    <section class="after">
      <div class="col">
        <h3>← <b>incoming</b> · {incoming.length} notes mention this</h3>
        {incoming.length === 0 ? (
          <p class="empty">no incoming backlinks yet.</p>
        ) : (
          <ul class="list">
            {incoming.map(n => (
              <li>
                <a href={`/wood/${n.slug}`}>
                  <span class={`blob ${n.data.stage}`}></span>
                  <span class="t">{n.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
      <div class="col">
        <h3>→ <b>outgoing</b> · this note points to</h3>
        {outgoing.length === 0 ? (
          <p class="empty">this note doesn't point anywhere yet.</p>
        ) : (
          <ul class="list">
            {outgoing.map(n => (
              <li>
                <a href={`/wood/${n.slug}`}>
                  <span class={`blob ${n.data.stage}`}></span>
                  <span class="t">{n.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>

    <div class="back-to-wood">
      <a href="/wood">← back to the wood</a>
    </div>

  </main>
</Base>

<style>
  .crumb { padding: 24px 0 8px; display: flex; justify-content: space-between; font-family: var(--font-h); font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-3); }
  .crumb a { color: inherit; text-decoration: none; }
  .crumb a:hover { color: var(--dye-tomato); }
  .crumb .sep { color: var(--ink-4); margin: 0 6px; }
  .crumb b { color: var(--ink); font-weight: 500; }
  .crumb .right { font-family: var(--font-mono); font-size: 11px; color: var(--ink-4); letter-spacing: 0.06em; }

  .note-head { max-width: 720px; margin: 0 auto; padding: 48px 0 32px; }
  .stage-line { display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-h); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; margin-bottom: 16px; }
  .stage-line .blob { width: 10px; height: 10px; border-radius: 50%; }
  .stage-line.seedling .blob { background: var(--dye-sage); }
  .stage-line.growing .blob { background: var(--dye-sun); }
  .stage-line.evergreen .blob { background: var(--dye-tomato); }
  .stage-line.seedling { color: var(--dye-sage); }
  .stage-line.growing { color: var(--dye-sun); }
  .stage-line.evergreen { color: var(--dye-tomato); }

  .note-head h1 { font-family: var(--font-card); font-weight: 400; font-size: clamp(40px, 6vw, 72px); line-height: 1.05; color: var(--ink); margin: 0 0 18px; text-wrap: balance; }
  .note-head .summary { font-family: var(--font-body); font-style: italic; font-size: 19px; line-height: 1.55; color: var(--ink-2); margin: 0 0 24px; max-width: 56ch; }

  .factrow { display: grid; grid-template-columns: auto 1fr; gap: 4px 16px; font-family: var(--font-mono); font-size: 12px; color: var(--ink-2); padding: 16px 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); margin: 0; }
  .factrow dt { color: var(--ink-3); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; }
  .factrow dd { margin: 0; }
  .factrow dd a { color: var(--dye-tomato); text-decoration: none; margin-right: 6px; }
  .factrow dd a:hover { text-decoration: underline; }

  .note-body { max-width: 720px; margin: 0 auto; padding: 32px 0; }
  .note-body :global(p) { font-family: var(--font-body); font-size: 18px; line-height: 1.7; color: var(--ink); margin: 0 0 22px; }
  .note-body :global(em) { font-family: var(--font-display); font-style: italic; font-size: 1.06em; }
  .note-body :global(h2), .note-body :global(h3) { font-family: var(--font-h); font-weight: 700; font-size: 22px; margin: 36px 0 14px; }
  .note-body :global(blockquote) { font-family: var(--font-display); font-style: italic; font-size: 24px; line-height: 1.3; border-left: 3px solid var(--dye-tomato); padding-left: 22px; margin: 30px 0; max-width: 32ch; }
  .note-body :global(code) { font-family: var(--font-mono); font-size: 0.86em; background: var(--paper-deep); padding: 0.1em 0.4em; border-radius: 2px; }
  .note-body :global(ul), .note-body :global(ol) { padding-left: 1.6em; margin: 0 0 22px; }
  .note-body :global(li) { font-family: var(--font-body); font-size: 17px; line-height: 1.55; margin-bottom: 6px; }
  .note-body :global(a) { color: var(--ink); text-decoration-color: var(--dye-tomato); text-decoration-thickness: 1.5px; }
  .note-body :global(hr) { border: 0; width: 60px; height: 1px; background: var(--ink-3); margin: 36px auto; }

  .after { max-width: 720px; margin: 32px auto 0; display: grid; grid-template-columns: 1fr 1fr; gap: 36px; padding-top: 28px; border-top: 1px dashed var(--ink-3); }
  .after h3 { font-family: var(--font-h); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--dye-tomato); margin: 0 0 12px; font-weight: 600; }
  .after h3 b { color: var(--ink); font-weight: 600; }
  .after .empty { font-family: var(--font-body); font-style: italic; font-size: 14px; color: var(--ink-3); margin: 0; }
  .after ul.list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 6px; }
  .after ul.list a { display: grid; grid-template-columns: auto 1fr; gap: 10px; padding: 8px 12px; background: var(--paper-soft); border: 1px solid var(--rule); text-decoration: none; align-items: center; transition: border-color var(--dur-base); }
  .after ul.list a:hover { border-color: var(--ink); }
  .after ul.list .blob { width: 7px; height: 7px; border-radius: 50%; }
  .after ul.list .blob.seedling  { background: var(--dye-sage); }
  .after ul.list .blob.growing   { background: var(--dye-sun); }
  .after ul.list .blob.evergreen { background: var(--dye-tomato); }
  .after ul.list .t { font-family: var(--font-body); font-style: italic; font-size: 14px; color: var(--ink); }

  .back-to-wood { max-width: 720px; margin: 48px auto 0; }
  .back-to-wood a { font-family: var(--font-h); font-size: 13px; color: var(--ink-3); text-decoration: none; }
  .back-to-wood a:hover { color: var(--dye-tomato); }

  @media (max-width: 760px) { .after { grid-template-columns: 1fr; gap: 28px; } }
</style>
