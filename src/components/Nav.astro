---
import Mark from './Mark.astro';
import { SITE, NAV, FEATURES } from '../site.config.js';

const { current = 'home' } = Astro.props;
---

<nav class="top">
  <div class="shell row">
    <a class="brand" href="/" aria-label="home">
      <Mark size={32} />
      <span class="word">{SITE.name}<span> · {SITE.brand}</span></span>
    </a>

    <ul>
      {NAV.map((item) => (
        <li>
          <a href={item.href} class:list={[{ cur: item.id === current }]}>{item.label}</a>
        </li>
      ))}
    </ul>

    <div class="end">
      {FEATURES.cmdkSearch && (
        <button class="cmdk" aria-label="open search">
          <span>search</span>
          <kbd>⌘K</kbd>
        </button>
      )}
    </div>
  </div>
</nav>

<style>
  nav.top {
    position: sticky; top: 0; z-index: 50;
    background: rgba(244, 238, 223, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule);
  }
  nav.top .row {
    display: flex; align-items: center; justify-content: space-between;
    padding: 18px 0;
  }
  nav.top .brand {
    display: inline-flex; align-items: center; gap: 12px;
    font-family: var(--font-h); font-weight: 700; font-size: 18px;
    color: var(--ink); text-decoration: none;
  }
  nav.top .brand .word { letter-spacing: -0.005em; }
  nav.top .brand .word :global(span) { color: var(--ink-3); font-weight: 400; }

  nav.top ul {
    list-style: none; padding: 0; margin: 0;
    display: flex; gap: 28px; align-items: center;
  }
  nav.top ul a {
    font-family: var(--font-h); font-weight: 400; font-size: 14px;
    color: var(--ink-2); text-decoration: none; letter-spacing: 0.005em;
    position: relative; padding: 4px 0;
  }
  nav.top ul a::after {
    content: ""; position: absolute;
    left: 0; right: 0; bottom: -2px;
    height: 1.5px; background: var(--dye-tomato);
    transform: scaleX(0); transform-origin: left;
    transition: transform var(--dur-base) var(--ease-out);
  }
  nav.top ul a:hover::after, nav.top ul a.cur::after { transform: scaleX(1); }
  nav.top ul a.cur { color: var(--ink); }

  nav.top .end { display: inline-flex; align-items: center; gap: 14px; min-height: 32px; }
  nav.top .cmdk {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: var(--font-mono); font-size: 11px; color: var(--dye-klein);
    border: 1px solid var(--dye-klein); padding: 4px 8px; border-radius: 2px;
    background: transparent; cursor: pointer;
    transition: background var(--dur-base), color var(--dur-base);
  }
  nav.top .cmdk:hover { background: var(--dye-klein); color: var(--paper); }
  nav.top .cmdk kbd { font-family: inherit; font-size: 10px; opacity: 0.7; }

  @media (max-width: 760px) {
    nav.top ul { display: none; }
  }
</style>
